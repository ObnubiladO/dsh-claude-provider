{
  "name": "dsh-claude-provider",
  "version": "0.1.3",
  "description": "Anthropic Claude Code provider for DeepSeek Harness: a Settings -> Providers panel that signs in with a Claude Pro/Max or Claude Code account over OAuth, using the harness authorization seam and pi-ai's Anthropic flow.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "claude",
    "claude-code",
    "anthropic",
    "oauth",
    "provider",
    "llm"
  ],
  "license": "MIT",
  "author": "ObnubiladO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObnubiladO/dsh-claude-provider.git"
  },
  "homepage": "https://github.com/ObnubiladO/dsh-claude-provider#readme",
  "bugs": {
    "url": "https://github.com/ObnubiladO/dsh-claude-provider/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-authorization": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.3.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-authorization": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "react": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true }
  }
}
